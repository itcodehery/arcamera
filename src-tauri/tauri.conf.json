{
  "$schema": "https://schema.tauri.app/2.0.0/tauri.schema.json",
  "productName": "Arcamera",
  "version": "0.1.0",
  "identifier": "com.arcamera.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arcamera",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": [
      "bin/ffmpeg"
    ]
  }
}
